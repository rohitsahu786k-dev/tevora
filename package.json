{
  "name": "tevora-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "validate": "vitest run src/tests/content.test.ts src/tests/relationships.test.ts src/tests/compatibility.test.ts",
    "a11y": "vitest run src/tests/navigation-accessibility.test.ts",
    "cms:dev": "sanity dev",
    "cms:deploy": "sanity deploy",
    "cms:schema": "sanity schema extract --path sanity/extract.json",
    "cms:typegen": "sanity typegen generate",
    "media:audit": "tsx scripts/audit-media.ts",
    "storage:upload": "node --env-file=.env.local --import tsx scripts/upload-cloudinary-assets.ts",
    "integrations:verify": "node --env-file=.env.local --import tsx scripts/verify-integrations.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@portabletext/react": "^6.2.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.4.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "mongodb": "^7.5.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "next-sanity": "^13.1.1",
    "nodemailer": "^9.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.81.0",
    "sanity": "^6.4.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.10",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
